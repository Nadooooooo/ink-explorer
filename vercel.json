{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && node scripts/prepare-vercel.mjs",
  "outputDirectory": "dist/static",
  "rewrites": [
    {
      "source": "/testnet/api/:path*",
      "destination": "/api/gateway?path=/testnet/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/gateway?path=/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/page?path=/$1"
    }
  ],
  "functions": {
    "api/gateway.mjs": {
      "maxDuration": 60
    },
    "api/page.mjs": {
      "maxDuration": 10,
      "includeFiles": "dist/{index.html,snapshots/pages/apps-*.json,snapshots/ecosystem/**}"
    }
  }
}
