{
  "name": "ink-explorer",
  "version": "1.0.0",
  "private": true,
  "description": "Independent block explorer for the Ink community, covering Mainnet and Sepolia.",
  "license": "MIT",
  "keywords": [
    "ink",
    "ethereum",
    "blockchain",
    "explorer",
    "op-stack",
    "blockscout"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/generate-locales.mjs && tsc -b && vite build && node scripts/prerender-home.mjs && node scripts/prerender-pages.mjs && node scripts/prerender-record-shells.mjs",
    "check": "tsc -b --pretty false",
    "test": "npm run check && npm run test:data && node --experimental-strip-types --test scripts/activity-data-test.mjs && npm run build",
    "start": "node --env-file-if-exists=.env server/server.mjs",
    "test:ws": "node scripts/test-websocket.mjs",
    "test:network-live": "node scripts/network-live-test.mjs",
    "test:a11y": "node scripts/a11y-test.mjs",
    "test:i18n": "node --experimental-strip-types scripts/i18n-test.mjs",
    "test:assets": "node scripts/asset-holdings-test.mjs",
    "test:charts": "node scripts/chart-interactions-current-test.mjs && node scripts/chart-integrity-browser-test.mjs && node --test scripts/chart-data-test.mjs scripts/chart-scale-test.mjs",
    "test:ui": "node --import ./scripts/ui-observe.mjs scripts/smoke-test.mjs",
    "test:security": "node scripts/security-test.mjs",
    "test:matcher-audit": "node --test scripts/audit-matcher-upstream-test.mjs && node scripts/audit-matcher-upstream.mjs",
    "test:identicons": "node scripts/identicon-test.mjs",
    "test:content": "node scripts/content-quality-test.mjs",
    "test:performance": "node scripts/performance-test.mjs",
    "test:lighthouse": "node scripts/lighthouse-audit.mjs",
    "test:loading": "node scripts/loading-regression-test.mjs",
    "test:contracts": "node scripts/contract-interaction-test.mjs",
    "test:networks": "node scripts/network-browser-test.mjs",
    "test:node-testnet": "node --env-file-if-exists=.env.sepolia scripts/testnet-node-status.mjs",
    "test:node-readiness": "node --test scripts/node-readiness-test.mjs",
    "test:layout": "node scripts/layout-stress-test.mjs",
    "test:style": "node scripts/style-consistency-test.mjs",
    "test:space": "node scripts/space-usage-test.mjs",
    "test:responsive": "node scripts/responsive-interactions-test.mjs",
    "capture": "node scripts/capture.mjs",
    "cache:nfts": "node scripts/cache-nfts.mjs",
    "test:mobile": "node scripts/mobile-usability-test.mjs",
    "test:drawer": "node scripts/drawer-focus-test.mjs",
    "test:data": "node --experimental-strip-types --test scripts/explorer-data-test.mjs scripts/api-request-test.mjs scripts/address-balance-test.mjs scripts/chain-statistics-test.mjs scripts/statistics-data-test.mjs",
    "test:integrity": "node scripts/explorer-integrity-test.mjs",
    "test:release": "node scripts/release-test.mjs",
    "test:post-deploy": "node scripts/post-deploy-test.mjs",
    "test:activity": "node --experimental-strip-types --test scripts/activity-data-test.mjs && node scripts/filter-journey-test.mjs && node scripts/filter-dialog-test.mjs && node scripts/filter-touch-test.mjs && node scripts/filter-module-recovery-test.mjs",
    "test:activity-live": "node scripts/activity-live-test.mjs",
    "test:activity-server": "node scripts/activity-server-test.mjs",
    "test:address-loading": "node scripts/address-loading-test.mjs && node scripts/address-live-browser-test.mjs",
    "test:readability": "node scripts/address-readability-test.mjs",
    "test:chain-reconciliation": "node --experimental-strip-types scripts/chain-reconciliation-test.mjs",
    "test:upstream-cache": "node scripts/upstream-cache-test.mjs",
    "test:data-freshness": "node scripts/data-notices-browser-test.mjs && node scripts/pool-freshness-test.mjs",
    "test:explorer-services": "node --test scripts/explorer-services-test.mjs",
    "test:explorer-pages": "node --experimental-strip-types --test scripts/apps-resource-test.mjs scripts/dapps-response-test.mjs scripts/page-prerender-test.mjs && node scripts/apps-direct-browser-test.mjs && node scripts/statistics-direct-browser-test.mjs && node scripts/explorer-pages-test.mjs",
    "tags:review": "node scripts/moderate-tags.mjs",
    "test:approvals": "node --experimental-strip-types scripts/approvals-test.mjs",
    "test:public-proxy": "node --experimental-strip-types --test scripts/public-proxy-test.mjs scripts/public-page-test.mjs scripts/wallet-relay-test.mjs scripts/review-http-proxy-test.mjs scripts/public-rpc-test.mjs",
    "test:wallet-discovery": "node --experimental-strip-types --test scripts/wallet-discovery-test.mjs",
    "test:wallet-discovery-browser": "node scripts/wallet-discovery-browser-test.mjs",
    "test:platform": "node scripts/platform-resilience-test.mjs && node scripts/profile-copy-focus-test.mjs",
    "test:navigation": "node scripts/explorer-link-memo-test.mjs && node scripts/navigation-links-test.mjs",
    "test:seo": "node --test scripts/page-seo-test.mjs scripts/cloudflare-worker-test.mjs scripts/release-gate-test.mjs scripts/compatibility-test.mjs",
    "test:seo-browser": "node scripts/page-seo-browser-test.mjs",
    "test:rpc-live": "node scripts/public-rpc-live-test.mjs",
    "test:api-connections": "node scripts/api-connections-browser-test.mjs",
    "test:rpc": "node --test scripts/public-rpc-test.mjs",
    "test:seo-parity": "node scripts/page-seo-parity-test.mjs",
    "test:search": "node --experimental-strip-types --test scripts/search-test.mjs",
    "test:search-browser": "node scripts/search-browser-test.mjs",
    "test:pool-identity": "node --experimental-strip-types --test scripts/pool-identity-test.mjs",
    "test:pool-detail": "node scripts/pool-detail-test.mjs",
    "test:lifecycle": "node scripts/live-lifecycle-test.mjs",
    "test:block-indexing-server": "node --test scripts/block-indexing-server-test.mjs",
    "test:block-indexing-browser": "node scripts/block-indexing-browser-test.mjs",
    "test:block-indexing-data": "node --experimental-strip-types --test scripts/block-indexing-data-test.mjs scripts/ledger-stream-guard-test.mjs",
    "test:token-market": "node scripts/token-market-scope-test.mjs",
    "test:startup": "node scripts/startup-recovery-test.mjs",
    "test:home-prerender": "node --test scripts/home-prerender-test.mjs scripts/initial-build-assets-test.mjs",
    "test:page-prerender": "node --test scripts/page-prerender-test.mjs",
    "test:page-arrival": "node scripts/page-arrival-browser-test.mjs",
    "test:home-arrival": "node scripts/home-arrival-browser-test.mjs",
    "test:home-recovery": "node scripts/home-recovery-browser-test.mjs",
    "test:home-live": "node scripts/home-live-acceptance-test.mjs",
    "test:search-handoff": "node scripts/search-handoff-browser-test.mjs",
    "test:search-ime": "node scripts/search-ime-browser-test.mjs",
    "test:release-gate": "node --test scripts/release-gate-test.mjs scripts/compatibility-test.mjs",
    "test:rolling": "node --test scripts/rolling-metrics-test.mjs scripts/rolling-integration-test.mjs",
    "test:rolling-browser": "node scripts/rolling-count-browser-test.mjs",
    "test:rolling-live": "node scripts/rolling-count-live-test.mjs",
    "test:network-observation": "node --test scripts/network-observation-test.mjs",
    "test:network-arrival": "node scripts/network-arrival-browser-test.mjs",
    "test:network-arrival-live": "node scripts/network-arrival-live-test.mjs",
    "test:ledger-arrival": "node scripts/ledger-arrival-browser-test.mjs",
    "test:stream-first": "node --experimental-strip-types --test scripts/stream-first-test.mjs",
    "test:stream-first-browser": "node scripts/stream-first-browser-test.mjs",
    "test:stream-first-live": "node scripts/stream-first-live-test.mjs",
    "test:record-arrival": "node --experimental-strip-types --test scripts/record-arrival-test.mjs scripts/record-document-test.mjs",
    "test:record-arrival-browser": "node scripts/record-arrival-browser-test.mjs",
    "test:record-arrival-live": "node scripts/record-arrival-live-test.mjs",
    "test:wallet-dependencies": "node --test scripts/wallet-dependency-test.mjs",
    "test:nft-media": "node --test scripts/nft-media-test.mjs scripts/video-thumbnail-test.mjs scripts/media-reader-rejection-test.mjs",
    "test:nft-live": "node scripts/nft-inventory-live-test.mjs",
    "test:nft-thumbnails": "node scripts/nft-thumbnail-browser-test.mjs",
    "test:nft-artwork": "node scripts/nft-artwork-browser-test.mjs",
    "test:nft-detail-media": "node scripts/nft-detail-media-browser-test.mjs",
    "test:transaction-summary": "node scripts/transaction-summary-stability-test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@walletconnect/core": "2.21.8",
    "@walletconnect/ethereum-provider": "2.21.8",
    "blo": "2.0.0",
    "ethers": "6.17.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.41.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "7.30.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "es-module-lexer": "3.0.2",
    "lighthouse": "13.5.0",
    "playwright-core": "1.63.0",
    "puppeteer-core": "25.16.0",
    "solc": "0.8.37",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    },
    "ws": "8.21.3",
    "decode-uri-component": "0.5.1",
    "viem": "2.57.2",
    "zod": "4.6.7",
    "follow-redirects": "1.16.3",
    "fast-uri": "3.1.9",
    "picomatch": "npm:@ryotsu/picomatch@4.0.7-a",
    "valtio": {
      "use-sync-external-store": "1.7.0"
    }
  }
}
